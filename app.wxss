page {
  background: #eef3f1;
  color: #17211d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

view,
text {
  box-sizing: border-box;
}

.safe-page {
  min-height: 100vh;
  padding: 24rpx;
}

.card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #d8e2de;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 44rpx rgba(26, 43, 38, 0.08);
}

.muted {
  color: #62716b;
}
